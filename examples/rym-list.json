  "people": [
    {
      "id": "lao-dengpao",
      "name": "Lao Dengpao",
      "native_name": "老灯泡",
      "pronunciation": "Лао Дэнпао",
      "tagline": "Биты из уличной еды и старых кассет.",
      "bio": {
        "text": "Я вырос над закусочной, где отец жарил лапшу до трёх ночи. Первые биты я собрал из звуков его кухни: стук ножа, шипение масла, радио на подоконнике.\n\nПсевдоним — от лампочки над входом. Она горела, сколько я себя помню.",
        "source": "Bandcamp",
        "url": "https://example-lao-dengpao.bandcamp.com"
      },
      "facts": [
        {
          "text": "Записывает биты на четырёхдорожечный кассетный магнитофон.",
          "source": "Discogs",
          "url": "https://www.discogs.com/artist/0000002"
        }
      ],
      "links": [
        {
          "kind": "rateyourmusic",
          "title": "RateYourMusic",
          "url": "https://rateyourmusic.com/artist/example-lao-dengpao"
        },
        {
          "kind": "bandcamp",
          "title": "Bandcamp",
          "url": "https://example-lao-dengpao.bandcamp.com"
        }
      ],
      "translations": {
        "en": {
          "pronunciation": "lao duhng-pao",
          "tagline": "Beats made of street food and old tapes.",
          "bio": {
            "text": "I grew up above a noodle stall where my father cooked until three in the morning. I built my first beats from the sounds of his kitchen: the knife, the hissing oil, the radio on the windowsill.\n\nThe name comes from the light bulb over the door. It was on for as long as I can remember.",
            "source": "Bandcamp",
            "url": "https://example-lao-dengpao.bandcamp.com"
          },
          "facts": [
            {
              "text": "Records his beats on a four-track cassette recorder.",
              "source": "Discogs",
              "url": "https://www.discogs.com/artist/0000002"
            }
          ]
        }
      }
    },
    {
      "id": "mtvaris-kuchebi",
      "name": "Mtvaris Kuchebi",
      "native_name": "მთვარის ქუჩები",
      "pronunciation": "Мтварис Кучеби",
      "tagline": "Трио из Тбилиси: три голоса и драм-машина.",
      "bio": {
        "text": "Мы пели в церковном хоре, пока не нашли в подвале старую драм-машину. Теперь поём то же многоголосие, только поверх бита.",
        "source": "their website",
        "url": "https://example.com/mtvaris-kuchebi"
      },
      "links": [
        {
          "kind": "rateyourmusic",
          "title": "RateYourMusic",
          "url": "https://rateyourmusic.com/artist/example-mtvaris-kuchebi"
        },
        {
          "kind": "website",
          "title": "Website",
          "url": "https://example.com/mtvaris-kuchebi"
        }
      ],
      "translations": {
        "en": {
          "pronunciation": "MTVAH-ris KOO-cheh-bee",
          "tagline": "A trio from Tbilisi: three voices and a drum machine.",
          "bio": {
            "text": "We sang in a church choir until we found an old drum machine in a basement. Now we sing the same polyphony, only over a beat.",
            "source": "their website",
            "url": "https://example.com/mtvaris-kuchebi"
          }
        }
      }
    }
